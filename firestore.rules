rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;

      match /watch_history/{historyId} {
        allow read, write: if true;
      }
      match /watch_later/{mediaId} {
        allow read, write: if true;
      }
    }

    match /support_messages/{messageId} {
      allow read, write: if true;
    }
  }
}
